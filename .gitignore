# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
#
# `.env*.local` saja TIDAK cukup: berkas yang benar-benar dipakai Next.js
# namanya `.env`, dan pola lama itu tidak menangkapnya. Satu `git add -A` sudah
# cukup untuk mendorong sandi basis data dan kunci API ke repositori publik.
# `.env.example` dikecualikan karena memang hanya berisi nama variabel, bukan
# nilainya.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# basis data lokal panel (SQLite) — berisi hash kata sandi & token sesi.
# JANGAN pernah dimasukkan ke git. Dibuat otomatis oleh src/lib/db.ts.
/.data/
*.db
*.db-shm
*.db-wal
