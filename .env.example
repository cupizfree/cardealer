# Contoh berkas lingkungan MARF.
#
# Salin jadi `.env` lalu isi nilainya:
#     cp .env.example .env
#
# `.env` TIDAK ikut git (lihat .gitignore). Berkas ini ikut git, jadi HANYA
# boleh memuat nama variabel dan contoh nilai palsu — jangan pernah menulis
# sandi, kunci API, atau token sungguhan di sini.

# ── Akun awal ────────────────────────────────────────────────────────────────
# Dibaca saat basis data masih kosong. Kalau kosong, server membuat sandi acak
# dan mencetaknya SEKALI ke konsol — catat dari log saat itu.
#
# Pakai sandi acak panjang dari pengelola sandi, dan pastikan admin dan staff
# TIDAK memakai sandi yang sama.
SEED_ADMIN_SANDI="ganti-dengan-sandi-acak-panjang"
SEED_STAFF_SANDI="ganti-dengan-sandi-acak-lain-yang-berbeda"

# Opsional. Bawaannya admin@marf.id / staff@marf.id.
# SEED_ADMIN_EMAIL="admin@marf.id"
# SEED_STAFF_EMAIL="staff@marf.id"

# ── Basis data ───────────────────────────────────────────────────────────────
# Bawaannya ./.data/marf.db. Skrip uji memakai jalur lain supaya tidak pernah
# menyentuh data produksi.
# MARF_DB_PATH="./.data/marf.db"

# ── Unggahan gambar ──────────────────────────────────────────────────────────
# Sengaja di luar public/ supaya tidak ikut terhapus saat situs dibangun ulang.
# MARF_UNGGAH_DIR="./.data/unggah"

# ── Surel (atur ulang kata sandi) ────────────────────────────────────────────
# Selama kuncinya kosong, tautan atur ulang TIDAK dikirim lewat surel —
# tautannya dicatat di tabel log_aktivitas supaya admin bisa menyerahkannya
# manual, dan antarmukanya mengatakan itu apa adanya.
# SUREL_API_KEY=""
# SUREL_API_URL="https://api.resend.com/emails"
# SUREL_DARI="MARF <no-reply@marf.id>"

# Alamat dasar yang dipakai saat menyusun tautan atur ulang.
# MARF_URL="http://localhost:3000"
